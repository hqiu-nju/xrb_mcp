# Local development only. Replace passwords before any nonlocal deployment.
POSTGRES_PASSWORD=xrb_dev_only
XRB_READER_PASSWORD=xrb_reader_dev_only
XRB_DATABASE_URL=postgresql+psycopg://xrb:xrb_dev_only@localhost:5432/xrb
XRB_READ_DATABASE_URL=postgresql+psycopg://xrb_reader:xrb_reader_dev_only@localhost:5432/xrb
XRB_DATA_DIR=./data
# none = explicitly lexical-only, sentence-transformers = actual hybrid search.
# Install with python -m pip install '.[dev,embeddings]' before enabling the latter.
XRB_EMBEDDING_BACKEND=none
XRB_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
XRB_EMBEDDING_REVISION=main
XRB_CHUNK_MAX_WORDS=350
